{
  "manifest_version": "0.2",
  "name": "avatarmcp",
  "version": "0.1.0",
  "description": "MCP server for managing and animating VRM avatars with comprehensive 3D model support, OSC integration, and real-time animation control",
  "author": {
    "name": "AvatarMCP Team",
    "email": "dev@avatarmcp.example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/yourusername/avatarmcp",
  "repository": "https://github.com/yourusername/avatarmcp.git",
  "server": {
    "type": "python",
    "entry_point": "src/avatarmcp/mcp_main.py",
    "mcp_config": {
      "command": "python",
      "args": ["src/avatarmcp/mcp_main.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1",
        "AVATARMCP_MODELS_DIR": "${user_config.models_dir}",
        "AVATARMCP_OSC_ENABLED": "${user_config.osc_enabled}",
        "AVATARMCP_OSC_CLIENT_ADDRESS": "${user_config.osc_client_address}",
        "AVATARMCP_OSC_CLIENT_PORT": "${user_config.osc_client_port}",
        "AVATARMCP_OSC_SERVER_ADDRESS": "${user_config.osc_server_address}",
        "AVATARMCP_OSC_SERVER_PORT": "${user_config.osc_server_port}"
      }
    }
  },
  "user_config": {
    "models_dir": {
      "type": "directory",
      "title": "VRM Models Directory",
      "description": "Directory containing VRM model files",
      "required": false,
      "default": "./models"
    },
    "osc_enabled": {
      "type": "boolean",
      "title": "Enable OSC Integration",
      "description": "Enable Open Sound Control for real-time avatar control",
      "default": false
    },
    "osc_client_address": {
      "type": "string",
      "title": "OSC Client Address",
      "description": "IP address for OSC client (sending messages)",
      "default": "127.0.0.1",
      "depends_on": "osc_enabled"
    },
    "osc_client_port": {
      "type": "string",
      "title": "OSC Client Port",
      "description": "Port for OSC client (sending messages)",
      "default": "9000",
      "depends_on": "osc_enabled"
    },
    "osc_server_address": {
      "type": "string",
      "title": "OSC Server Address",
      "description": "IP address for OSC server (receiving messages)",
      "default": "127.0.0.1",
      "depends_on": "osc_enabled"
    },
    "osc_server_port": {
      "type": "string",
      "title": "OSC Server Port",
      "description": "Port for OSC server (receiving messages)",
      "default": "9001",
      "depends_on": "osc_enabled"
    }
  },
  "tools": [
    {
      "name": "initialize",
      "description": "Initialize the AvatarMCP server and scan for VRM models",
      "inputSchema": {
        "type": "object",
        "properties": {
          "models_dir": {
            "type": "string",
            "description": "Directory to scan for VRM models"
          }
        }
      }
    },
    {
      "name": "shutdown",
      "description": "Shutdown the AvatarMCP server",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "avatar_load",
      "description": "Load a VRM avatar model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to VRM file or model ID"
          },
          "make_active": {
            "type": "boolean",
            "description": "Set as active avatar",
            "default": true
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata for the avatar"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "avatar_unload",
      "description": "Unload a VRM avatar model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Avatar ID to unload"
          },
          "force": {
            "type": "boolean",
            "description": "Force unload even if active",
            "default": false
          }
        },
        "required": ["id"]
      }
    },
    {
      "name": "avatar_list",
      "description": "List available and loaded avatar models",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loaded_only": {
            "type": "boolean",
            "description": "Show only loaded avatars",
            "default": false
          },
          "include_metadata": {
            "type": "boolean",
            "description": "Include detailed metadata",
            "default": false
          }
        }
      }
    },
    {
      "name": "avatar_set_active",
      "description": "Set the active avatar model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Avatar ID to set as active"
          }
        },
        "required": ["id"]
      }
    },
    {
      "name": "avatar_get_active",
      "description": "Get the currently active avatar model",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "avatar_get_metadata",
      "description": "Get detailed metadata for an avatar",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Avatar ID (defaults to active)"
          }
        }
      }
    },
    {
      "name": "animation_play",
      "description": "Play an animation on the active avatar",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Animation name to play"
          }
        },
        "required": ["name"]
      }
    },
    {
      "name": "animation_stop",
      "description": "Stop the current animation",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "animation_list",
      "description": "List available animations",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "parameter_set",
      "description": "Set an avatar parameter value",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          },
          "value": {
            "type": ["number", "string"],
            "description": "Parameter value"
          }
        },
        "required": ["name", "value"]
      }
    },
    {
      "name": "parameter_get",
      "description": "Get an avatar parameter value",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          }
        },
        "required": ["name"]
      }
    },
    {
      "name": "osc_send",
      "description": "Send an OSC message",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "OSC address pattern"
          },
          "value": {
            "type": ["number", "string"],
            "description": "Value to send"
          }
        },
        "required": ["address", "value"]
      }
    },
    {
      "name": "osc_receive",
      "description": "Receive OSC messages",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "chat_start",
      "description": "Start a chat session",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "chat_send_message",
      "description": "Send a message in the chat session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to send"
          }
        },
        "required": ["message"]
      }
    },
    {
      "name": "chat_stop",
      "description": "Stop the current chat session",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "chat_get_state",
      "description": "Get the current chat session state",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "system_status",
      "description": "Get system status and diagnostics",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "debug_echo",
      "description": "Echo debug message for testing",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "object",
            "description": "Message to echo back"
          }
        },
        "required": ["message"]
      }
    }
  ],
  "compatibility": {
    "platforms": ["win32", "darwin", "linux"],
    "python_version": ">=3.9",
    "dependencies": {
      "fastmcp": ">=2.12.0",
      "numpy": ">=1.21.0",
      "python-osc": ">=1.8.2",
      "pygltflib": ">=1.14.0",
      "trimesh": ">=3.9.0",
      "pyvista": ">=0.35.0"
    }
  },
  "categories": [
    "avatar",
    "3d-modeling",
    "animation",
    "osc",
    "real-time",
    "virtual-reality"
  ],
  "keywords": [
    "VRM",
    "avatar",
    "3D",
    "animation",
    "OSC",
    "MCP",
    "Claude Desktop"
  ]
}
