{
  "name": "avatarmcp",
  "version": "0.1.0",
  "display_name": "Avatar MCP",
  "description": "MCP server for managing and animating VRM avatars with support for animations, expressions, and real-time control",
  "author": "AvatarMCP Team",
  "license": "MIT",
  
  "server": {
    "command": ["python", "-m", "avatarmcp"],
    "timeout": 30,
    "launch_delay": 0,
    "stdio": true,
    "auto_start": true,
    "env": {
      "PYTHONUNBUFFERED": "1",
      "PYTHONIOENCODING": "utf-8"
    }
  },

  "tools": [
    {
      "name": "load_vrm",
      "description": "Load a VRM/VRoid avatar model",
      "parameters": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "Path to the VRM file to load"
          },
          "avatar_id": {
            "type": "string",
            "description": "Optional ID to assign to the avatar. If not provided, one will be generated."
          }
        },
        "required": ["file_path"]
      }
    },
    {
      "name": "play_animation",
      "description": "Play an animation on an avatar",
      "parameters": {
        "type": "object",
        "properties": {
          "avatar_id": {
            "type": "string",
            "description": "ID of the avatar to animate"
          },
          "animation_name": {
            "type": "string",
            "description": "Name of the animation to play (e.g., 'idle', 'wave')",
            "enum": ["idle", "wave"]
          },
          "loop": {
            "type": "boolean",
            "description": "Whether the animation should loop",
            "default": true
          },
          "weight": {
            "type": "number",
            "description": "Blend weight (0.0 to 1.0)",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 1.0
          },
          "speed": {
            "type": "number",
            "description": "Playback speed multiplier",
            "minimum": 0.1,
            "default": 1.0
          }
        },
        "required": ["avatar_id", "animation_name"]
      }
    },
    {
      "name": "stop_animation",
      "description": "Stop an animation on an avatar",
      "parameters": {
        "type": "object",
        "properties": {
          "avatar_id": {
            "type": "string",
            "description": "ID of the avatar"
          },
          "animation_name": {
            "type": "string",
            "description": "Name of the animation to stop. If not provided, all animations will be stopped."
          }
        },
        "required": ["avatar_id"]
      }
    },
    {
      "name": "set_pose",
      "description": "Set the pose of an avatar's bone",
      "parameters": {
        "type": "object",
        "properties": {
          "avatar_id": {
            "type": "string",
            "description": "ID of the avatar"
          },
          "bone_name": {
            "type": "string",
            "description": "Name of the bone to pose"
          },
          "rotation": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4,
            "description": "Quaternion rotation (x, y, z, w)"
          },
          "position": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3,
            "description": "Position (x, y, z)"
          }
        },
        "required": ["avatar_id", "bone_name"]
      }
    },
    {
      "name": "get_avatar_info",
      "description": "Get information about a loaded avatar",
      "parameters": {
        "type": "object",
        "properties": {
          "avatar_id": {
            "type": "string",
            "description": "ID of the avatar to get information about"
          }
        },
        "required": ["avatar_id"]
      }
    }
  ]
}
