{
    "name": "avatar-mcp",
    "version": "0.1.0",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/avatarmcp/server.py",
    "dependencies": [
        "fastmcp>=3.1.0",
        "numpy>=1.21.0",
        "python-osc>=1.8.2",
        "pygltflib>=1.14.0",
        "trimesh>=3.9.0",
        "packaging>=21.0",
        "httpx>=0.27.0",
        "fastapi>=0.132.0",
        "uvicorn[standard]>=0.38.0",
        "aiofiles>=23.1.0"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/",
            "web_sota/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/avatar-mcp.mcpb",
        "test": "uv run pytest tests/ -v"
    }
}
